{
  "name": "westvalley-overlay",
  "version": "1.2.9",
  "description": "Overlay telefonu i MDT nad gr\u0105 \u2014 F1 / F2",
  "main": "main.js",
  "author": "West Valley RP",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64",
    "build:dir": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.westvalley.overlay",
    "productName": "WestValley Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "phone-shell.html",
      "mdt-shell.html",
      "control.html",
      "package.json",
      "wvpl.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WestValley-Overlay.exe",
      "icon": "wvpl.ico"
    },
    "portable": {
      "artifactName": "WestValley-Overlay.exe"
    },
    "compression": "maximum",
    "asar": true,
    "icon": "wvpl.ico",
    "extraResources": [
      {
        "from": "wvpl.ico",
        "to": "wvpl.ico"
      }
    ]
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  }
}
